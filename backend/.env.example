# Local Qwen runtime: Ollama by default, or a vLLM OpenAI-compatible endpoint.
LOCAL_VLM_RUNTIME=ollama
LOCAL_VLM_BASE_URL=http://localhost:11434/v1
LOCAL_VLM_MODEL=qwen2.5vl:7b
# LOCAL_VLM_API_KEY=optional-local-key
LOCAL_VLM_TIMEOUT_SECONDS=120
LOCAL_VLM_MAX_STRUCTURED_OUTPUT_RETRIES=2

# Primary local parser. Use gpu or gpu:0 only when the matching GPU runtime is installed.
PADDLEOCR_ENGINE=paddle
PADDLEOCR_DEVICE=cpu

# Optional. Defaults to ~/.invoice-review, outside this repository.
# INVOICE_REVIEW_DATA_DIR=/absolute/path/to/invoice-review-data
